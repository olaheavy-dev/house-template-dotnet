# Copy to backend/.env for `make dev-backend`; it is never committed. Production sets the same names
# in its environment. A double underscore is a section: Api__CorsOrigins__0 is Api:CorsOrigins:0.

# Development turns on the API reference at /scalar and readable logs (make dev-backend's default).
ASPNETCORE_ENVIRONMENT=Development

# Host headers the API answers to, separated by ';' (api.example.com). * accepts any.
AllowedHosts=*

# Browser origins allowed to call the API directly (CORS), one per index. Behind the Next.js proxy
# none are needed.
# Api__CorsOrigins__0=https://app.example.com

# Limits, with their defaults.
# Api__MaxRequestBodyBytes=1048576
# Api__RequestTimeoutSeconds=30
# Api__RateLimitPerMinute=600

# OpenTelemetry: nothing is exported until an endpoint is set (the Aspire dashboard locally, any OTLP
# collector in production). The service name defaults to appsettings.json's OpenTelemetry:ServiceName.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=
