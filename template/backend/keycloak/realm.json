{
  "realm": "app",
  "enabled": true,
  "displayName": "Local sign-in",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "defaultRole": {
    "name": "default-roles-app",
    "description": "Every user's roles: the permissions any signed-in user has."
  },
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-app",
        "description": "Every user's roles: the permissions any signed-in user has.",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "api": [
              "me.read"
            ]
          }
        }
      }
    ],
    "client": {
      "api": [
        {
          "name": "me.read",
          "description": "See your own account (GET /v1/me). Every user has it through the default roles."
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "api",
      "name": "The API",
      "description": "The audience of access tokens; its client roles are the API's permissions.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "web",
      "name": "The Next.js frontend",
      "enabled": true,
      "publicClient": false,
      "secret": "local-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "local-cli",
      "name": "Local tokens for curl and the tests",
      "description": "Password grant, for local use only: never import this realm into a shared Keycloak.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@example.com",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-app"
      ]
    },
    {
      "username": "visitor",
      "email": "visitor@example.com",
      "emailVerified": true,
      "firstName": "Visitor",
      "lastName": "Without permissions",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "visitor",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
