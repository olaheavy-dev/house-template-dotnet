# Owned by house-template-dotnet. C# style for backend/; base's root .editorconfig sets indentation.

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning
# A value assigned and never read (InspectCode reports it only as a hint).
dotnet_diagnostic.IDE0059.severity = warning

# var: use it when the type is obvious from the right-hand side
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Braces and qualification
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning

# Naming
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Private static readonly fields are constants in practice: PascalCase, no underscore (the more
# specific rule wins over the one below).
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_camel_underscore.severity = warning
dotnet_naming_rule.private_fields_camel_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_camel_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Rules that don't fit an application (every other analyzer rule stays an error):
# CA1716: names that are keywords in other languages (Error is a Visual Basic keyword); this is C# only.
dotnet_diagnostic.CA1716.severity = none
# CA1812: internal classes DI creates (handlers, the dispatcher) look uninstantiated to the analyzer.
dotnet_diagnostic.CA1812.severity = none
# CA1040: marker interfaces (ICommand, IQuery<T>) are empty by design.
dotnet_diagnostic.CA1040.severity = none
# CA2007: ConfigureAwait matters only with a synchronisation context; ASP.NET Core and the tests have none.
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
# Test names read Method_condition_result, so underscores are expected.
dotnet_diagnostic.CA1707.severity = none
# NUnit discovers public test fixtures.
dotnet_diagnostic.CA1515.severity = none
# Expected values read best inline in an assertion; a test runs each one once.
dotnet_diagnostic.CA1861.severity = none

# JetBrains InspectCode (make check), where the frameworks make a finding wrong:
# - Immediate.Handlers fixes a handler's HandleAsync(request, cancellationToken) signature, so a
#   handler that doesn't need one of them still declares it.
# - Response records in Application are read by the JSON serializer, which InspectCode can't see.
[{src/Modules/**/*.Application/**.cs,templates/module/**/*.Application/**.cs,tests/**.cs}]
resharper_unused_parameter_local_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none

# EF Core writes migrations; they are regenerated, never hand-edited, so the analyzers, the
# formatter and InspectCode leave them alone.
[**/Persistence/Migrations/*.cs]
generated_code = true
