<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- One lock file for every configuration: the package is always restored, but only Debug takes its assemblies.
         (A reference that exists only in Debug gives Debug and Release different lock files, so any Release build
         that restores rewrites the committed one and the next locked restore fails.) -->
    <RuntimeCompilationAssets Condition="'$(Configuration)' == 'Debug'">all</RuntimeCompilationAssets>
    <RuntimeCompilationAssets Condition="'$(Configuration)' != 'Debug'">none</RuntimeCompilationAssets>
    <!-- The build writes the OpenAPI document to backend/openapi/v1.json, which is committed: the
         Next.js layer generates its client types from it. make check builds it elsewhere and fails
         if the committed one differs. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <!-- The generator reruns only when Api.dll changes, so an endpoint added in a module, or a build
       to another directory (make check), would leave the document stale. Regenerate on every build. -->
  <Target Name="RegenerateOpenApiDocumentEveryBuild" BeforeTargets="GenerateOpenApiDocuments">
    <Delete Files="$(_OpenApiDocumentsCache)" />
  </Target>
  <!-- The generator writes no final newline; add one, so base's end-of-file hook and every rebuild
       agree on the committed file. -->
  <UsingTask TaskName="EndFileWithNewline" TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.ReadAllText(Path).EndsWith("\n", System.StringComparison.Ordinal))
        {
            System.IO.File.AppendAllText(Path, "\n");
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="EndOpenApiDocumentWithNewline" AfterTargets="GenerateOpenApiDocuments">
    <EndFileWithNewline Path="$(OpenApiDocumentsDirectory)/v1.json" />
  </Target>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Writes the messaging glue code (make codegen) and lets Development generate it on the fly; Release builds
         compile the committed code instead and ship no compiler. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" IncludeAssets="$(RuntimeCompilationAssets)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Common\Common.Infrastructure\Common.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Common\Common.Presentation\Common.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Platform\Modules.Platform.Infrastructure\Modules.Platform.Infrastructure.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The integration and acceptance tests start this host through WebApplicationFactory<Program>. -->
    <InternalsVisibleTo Include="IntegrationTests" />
    <InternalsVisibleTo Include="AcceptanceTests" />
  </ItemGroup>
</Project>
