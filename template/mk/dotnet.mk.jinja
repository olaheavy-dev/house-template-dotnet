# Owned by house-template-dotnet. Included by the base Makefile; adds the backend's install and
# checks to `make install`, `make check` and `make check-fast`. Its own targets end in -backend.

BACKEND := backend/Backend.slnx
ARTIFACTS ?= .artifacts
# No telemetry from the .NET CLI or the test platform.
export DOTNET_CLI_TELEMETRY_OPTOUT := 1
export DOTNET_NOLOGO := 1
export TESTINGPLATFORM_TELEMETRY_OPTOUT := 1

# Fails on any package (direct or transitive) whose licence isn't in backend/licenses/allowed.json.
define LICENSES
dotnet nuget-license --input $(BACKEND) --include-transitive --allowed-license-types backend/licenses/allowed.json \
	--override-package-information backend/licenses/overrides.json --error-only
endef

# JetBrains InspectCode on the built solution; any finding at warning or above fails. The fixtures
# break the architecture rules on purpose, so they're left out. Exceptions live in backend/.editorconfig.
define INSPECT
@mkdir -p $(ARTIFACTS)
@rm -f $(ARTIFACTS)/inspectcode.sarif
dotnet jb inspectcode $(BACKEND) --output=$(ARTIFACTS)/inspectcode.sarif --format=Sarif --severity=WARNING \
	--no-build --properties:Configuration=Release --verbosity=WARN --exclude='**/ArchitectureTests.Fixtures/**'
@test -s $(ARTIFACTS)/inspectcode.sarif || { echo "InspectCode produced no report"; exit 1; }
@if grep -q '"ruleId"' $(ARTIFACTS)/inspectcode.sarif; then \
	echo "InspectCode found issues ($(ARTIFACTS)/inspectcode.sarif):"; \
	grep -E '"(ruleId|uri|startLine)"' $(ARTIFACTS)/inspectcode.sarif | head -60; exit 1; fi
@echo "InspectCode: no issues."
endef

# The OpenAPI document the build writes and the Next.js layer reads. make check builds into
# $(ARTIFACTS) instead and fails if the committed one differs, so a check never rewrites the tree.
OPENAPI := backend/openapi/v1.json
OPENAPI_BUILT := $(ARTIFACTS)/openapi/v1.json

INSTALLS += install-dotnet
CHECKS += check-dotnet
FAST_CHECKS += check-fast-dotnet

.PHONY: codegen migrate migrate-bundle seed install-dotnet check-dotnet check-fast-dotnet build-backend openapi-backend test-backend dev-backend lock-backend module licenses-backend inspect-backend doctor-backend package-health

install-dotnet: ## Restore the backend's tools and packages from their lock files (needs the SDK in global.json)
	dotnet tool restore
	dotnet restore $(BACKEND) --locked-mode

check-dotnet: install-dotnet ## Backend: formatting, a build with every analyzer warning as an error, the OpenAPI document up to date, licences, InspectCode at zero issues, and the tests with coverage
	dotnet format $(BACKEND) --verify-no-changes --no-restore
	# Restores for Release (locked) rather than reusing Debug's: Release must build without the code-generation compiler.
	dotnet build $(BACKEND) --configuration Release -p:RestoreLockedMode=true -p:OpenApiDocumentsDirectory=$(abspath $(dir $(OPENAPI_BUILT)))
	@cmp -s $(OPENAPI) $(OPENAPI_BUILT) || { echo "$(OPENAPI) is out of date: run make openapi-backend and commit it."; \
		diff -u $(OPENAPI) $(OPENAPI_BUILT) | head -40; exit 1; }
	$(LICENSES)
	$(INSPECT)
	@rm -rf $(ARTIFACTS)/codegen
	$(call CODEGEN,$(abspath $(ARTIFACTS)/codegen))
	@diff -r $(GENERATED) $(ARTIFACTS)/codegen >/dev/null || { echo "$(GENERATED) is out of date: run make codegen and commit it."; \
		diff -r $(GENERATED) $(ARTIFACTS)/codegen | head -40; exit 1; }
	dotnet test --solution $(BACKEND) --configuration Release --no-build --coverlet --coverlet-output-format cobertura --results-directory $(ARTIFACTS)/test-results
	# Again in Debug: ArchUnitNET reads the compiled IL, and Release optimisations can hide a dependency.
	dotnet test --project backend/tests/ArchitectureTests --configuration Debug

check-fast-dotnet: build-backend ## Backend: the build and its analyzers (the pre-push and stop-hook checks)

build-backend: ## Build the backend (Release)
	dotnet build $(BACKEND) --configuration Release

openapi-backend: ## Write backend/openapi/v1.json from the code (any build does; commit it)
	dotnet build backend/src/Api/Api --configuration Release

test-backend: ## Run the backend's tests
	dotnet test --solution $(BACKEND) --configuration Release

dev-backend: ## Run the API with reload on http://localhost:5000, in Development, with backend/.env's settings
	@export ASPNETCORE_ENVIRONMENT=Development; \
	if [ -f backend/.env ]; then set -a; . ./backend/.env; set +a; fi; \
	dotnet watch --project backend/src/Api/Api run --urls http://localhost:5000

lock-backend: ## Update the lock files after changing backend/Directory.Packages.props or a project's packages
	dotnet restore $(BACKEND) --force-evaluate

# A project-local template store, so `make module` installs nothing on the machine.
TEMPLATE_HIVE := $(ARTIFACTS)/dotnet-new
PROGRAM := backend/src/Api/Api/Program.cs

module: ## Add a module in its six projects with an example query and test: make module NAME=Billing
	@case "$(NAME)" in [A-Z]*) ;; *) echo "Usage: make module NAME=Billing (PascalCase)"; exit 1;; esac
	@case "$(NAME)" in *[!A-Za-z0-9]*) echo "NAME must be letters and digits only"; exit 1;; esac
	@test ! -e backend/src/Modules/$(NAME) || { echo "backend/src/Modules/$(NAME) already exists"; exit 1; }
	dotnet new install backend/templates/module --force --debug:custom-hive $(TEMPLATE_HIVE) >/dev/null
	dotnet new house-module --name $(NAME) --output backend --debug:custom-hive $(TEMPLATE_HIVE)
	dotnet sln $(BACKEND) add $$(find backend/src/Modules/$(NAME) backend/tests/Modules.$(NAME).UnitTests -name '*.csproj' | sort)
	dotnet add backend/src/Api/Api/Api.csproj reference backend/src/Modules/$(NAME)/Modules.$(NAME).Infrastructure/Modules.$(NAME).Infrastructure.csproj
	awk -v name=$(NAME) 'NR == 1 { print "using Modules." name ".Infrastructure;"; print "using Modules." name ".Presentation;" } \
		/\/\/ make module: registrations/ { print "builder.Services.Add" name "Module(builder.Configuration);" } \
		/\/\/ make module: endpoints/ { print "app.Map" name "Endpoints();" } { print }' \
		$(PROGRAM) > $(PROGRAM).new && mv $(PROGRAM).new $(PROGRAM)
	dotnet restore $(BACKEND) --force-evaluate
	# The module's first migration, from its example entity.
	dotnet tool restore
	dotnet ef migrations add Initial --project backend/src/Modules/$(NAME)/Modules.$(NAME).Infrastructure --output-dir Persistence/Migrations
	dotnet format $(BACKEND) --include $(PROGRAM) --no-restore
	# A module's subscribers change the host's glue code.
	rm -rf $(GENERATED)
	$(call CODEGEN,$(abspath $(GENERATED)))
	# The module's example endpoint changes the OpenAPI document.
	dotnet build backend/src/Api/Api --configuration Release --no-restore
	@echo "Added module $(NAME): backend/src/Modules/$(NAME), its tests, its database schema and first migration, its registration in Program.cs and its endpoint in $(OPENAPI). Run make check."

# The messaging glue code Wolverine writes for the host (it is compiled in, so Release builds need no compiler).
# A throwaway connection string gives it the shape it has in production; nothing connects.
GENERATED := backend/src/Api/Api/Internal/Generated
define CODEGEN
dotnet build backend/src/Api/Api --configuration Debug -p:RestoreLockedMode=true -p:OpenApiDocumentsDirectory=$(abspath $(ARTIFACTS)/openapi-debug)
ConnectionStrings__Default='Host=localhost;Database=codegen' Messaging__GeneratedCodePath=$(1) \
	dotnet backend/src/Api/Api/bin/Debug/net10.0/Api.dll codegen write
# Wolverine leaves trailing spaces; base's pre-commit would trim them, and the check would then see a difference.
find $(1) -name '*.cs' -exec perl -pi -e 's/[ \t]+$$//' {} +
endef

codegen: ## Regenerate the messaging glue code after adding or changing a subscriber (commit the result)
	rm -rf $(GENERATED)
	$(call CODEGEN,$(abspath $(GENERATED)))

# Every module with a database, and the shared kernel's, has an IDesignTimeDbContextFactory in its Infrastructure project.
MIGRATION_PROJECTS = $$(find backend/src -name '*DbContextFactory.cs' -not -path '*/obj/*' -not -path '*/bin/*' | sed 's|/[^/]*/[^/]*$$||' | sort)

migrate: ## Apply every module's migrations to the database in ConnectionStrings__Default (backend/.env or the environment)
	@if [ -f backend/.env ]; then set -a; . ./backend/.env; set +a; fi; \
	test -n "$$ConnectionStrings__Default" || { echo "Set ConnectionStrings__Default (see backend/.env.example)"; exit 1; }; \
	for project in $(MIGRATION_PROJECTS); do \
		dotnet ef database update --project $$project --connection "$$ConnectionStrings__Default" || exit 1; \
	done

migrate-bundle: ## Build one migration executable per module in .artifacts/migrations; RUNTIME=linux-x64 makes it self-contained for that platform
	@mkdir -p $(ARTIFACTS)/migrations
	@for project in $(MIGRATION_PROJECTS); do \
		module=$$(basename $$(dirname $$project)); \
		dotnet ef migrations bundle --project $$project --output $(ARTIFACTS)/migrations/migrate_$$module --force $(if $(RUNTIME),--self-contained --target-runtime $(RUNTIME)) || exit 1; \
	done
	# Building a bundle restores for a runtime, which writes it into the lock files; put them back.
	dotnet restore $(BACKEND) --force-evaluate

seed: ## Add example data for development (a no-op where it already exists)
	@export ASPNETCORE_ENVIRONMENT=Development; \
	if [ -f backend/.env ]; then set -a; . ./backend/.env; set +a; fi; \
	dotnet run --project backend/src/Api/Api -- seed

doctor-backend: ## Check this machine has what the backend needs: the SDK global.json names, Docker for integration tests
	@command -v dotnet >/dev/null || { echo "dotnet not found: install the .NET SDK named in global.json"; exit 1; }
	@dotnet --version >/dev/null 2>&1 || { echo "The .NET SDK in global.json isn't installed:"; dotnet --version; exit 1; }
	@echo ".NET SDK $$(dotnet --version) (global.json asks for $$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' global.json | head -1) or a later patch)"
	@command -v docker >/dev/null && docker info >/dev/null 2>&1 && echo "Docker: running" \
		|| echo "Docker: not running (the integration tests and make up need it)"
	@dotnet tool restore >/dev/null && echo "Tools: restored (.config/dotnet-tools.json)"

package-health: ## Flag pinned packages with no release on nuget.org for a year (needs network)
	python3 tools/check_package_health.py

licenses-backend: install-dotnet ## Fail on any package (direct or transitive) whose licence isn't allowed
	$(LICENSES)

inspect-backend: build-backend ## Run JetBrains InspectCode on a Release build and fail on any issue
	$(INSPECT)
